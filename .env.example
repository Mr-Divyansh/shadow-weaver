# Shadow-Weaver Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════
# AI CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Gemini API Key (for AI-driven attack strategy)
# Get yours at: https://makersuite.google.com/app/apikey
# NOTE: with no key set, the AI Security Analyst automatically falls back to
# its deterministic rule engine — the full pipeline still works end-to-end.
GEMINI_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# ── AI Security Analyst (optional — all values have safe defaults) ──────────
# Master switch for the orchestrator-side AI analysis/decision pipeline
# AI_ANALYST_ENABLED=true
# Gemini call timeout in seconds (AI falls back to deterministic engine on timeout)
# AI_TIMEOUT=8.0
# Dedup window (seconds) — prevents duplicate AI calls for the same source+threat
# AI_DEDUP_WINDOW=90
# Post-action verification window in seconds
# AI_VERIFICATION_WINDOW=6.0
# Max concurrent AI analyses (1 = strictly serial, cost-safe)
# AI_MAX_CONCURRENT=1
# Policy: BLOCK/ISOLATE only allowed at or above these thresholds
# AI_BLOCK_MIN_CONFIDENCE=0.7
# AI_BLOCK_MIN_RISK=70

# ═══════════════════════════════════════════════════════════════
# EXECUTOR CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Dry Run Mode (true = log commands only, false = execute real commands)
# WARNING: Set to false only if you understand the security implications
EXECUTOR_DRY_RUN=true

# Firewall Tool (auto | iptables | ufw | netsh)
FIREWALL_TOOL=auto

# SSH Config Path (Linux only)
SSH_CONFIG_PATH=/etc/ssh/sshd_config

# ═══════════════════════════════════════════════════════════════
# ALERT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Discord Webhook URL (for security alerts)
DISCORD_WEBHOOK_URL=

# Slack Webhook URL (for security alerts)
SLACK_WEBHOOK_URL=

# Generic Webhook URLs (comma-separated)
GENERIC_WEBHOOKS=

# ═══════════════════════════════════════════════════════════════
# AI SECURITY ANALYST (orchestrator-side decision engine)
# ═══════════════════════════════════════════════════════════════

# Uses GEMINI_KEY above when present. Without it the deterministic rule
# engine answers with the same JSON schema — the dashboard never breaks.
# AI_ANALYST_ENABLED=true
# AI_TIMEOUT=8.0                  # Gemini call timeout (seconds)
# AI_DEDUP_WINDOW=90              # skip duplicate AI runs per source+pattern (seconds)
# AI_VERIFICATION_WINDOW=6.0      # post-action telemetry watch window (seconds)
# AI_MAX_CONCURRENT=1             # max in-flight AI analyses
# AI_BLOCK_MIN_CONFIDENCE=0.7     # policy gate for BLOCK/ISOLATE
# AI_BLOCK_MIN_RISK=70            # policy gate for BLOCK/ISOLATE

# ═══════════════════════════════════════════════════════════════
# SERVICE PORTS
# ═══════════════════════════════════════════════════════════════

# Orchestrator (default: 8000)
# ORCH_PORT=8000

# Blue Shield (default: 8080)
# BLUE_PORT=8080

# Honeypot (default: 8022)
# HONEY_PORT=8022

# Frontend (default: 3000)
# FRONTEND_PORT=3000
